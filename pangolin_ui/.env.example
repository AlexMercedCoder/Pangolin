# Base URL of the Pangolin API.
#
# B31: this file used to declare VITE_API_URL, the compose files passed
# VITE_API_URL, and the client read PUBLIC_API_URL - three names, none of which
# agreed, so the client's fallback always won and every deployed build called
# `http://localhost:8080`, meaning the *visitor's* machine.
#
# SvelteKit's dynamic public env requires the PUBLIC_ prefix, so PUBLIC_API_URL
# is the correct name and now the only one.
#
# Leave it empty for a same-origin (reverse-proxy) deployment.
PUBLIC_API_URL=http://localhost:8080
